// agentic-security CI gate for Jenkins (declarative pipeline).
// Add this stage to your existing Jenkinsfile or use as a standalone.

pipeline {
  agent any
  tools { nodejs 'node24' }
  stages {
    stage('Security · agentic-security') {
      steps {
        // promoted compiler rules are re-scored against their corpora and the shared false-positive corpus BEFORE the scan gate, so a
        // failing gate cannot hide a rule regression; exit 1 on a regression, 0 with none promoted. Set AGENTIC_SECURITY_RULES_PUBLIC_KEY
        // in the job's environment so the committed rule ledger's author signature verifies on this agent.
        sh 'npx --yes agentic-security rules regress'
        sh 'npx --yes agentic-security ci . --fail-on high'
      }
      post {
        always {
          archiveArtifacts artifacts: '.agentic-security/findings.json, .agentic-security/findings.sarif, .agentic-security/findings.junit.xml',
                           allowEmptyArchive: true
          recordIssues tools: [
            sarif(pattern: '.agentic-security/findings.sarif')
          ]
        }
      }
    }
  }
}
