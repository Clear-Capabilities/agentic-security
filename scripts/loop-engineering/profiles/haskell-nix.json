{
  "profileVersion": 1,
  "name": "haskell-nix",
  "description": "Execution profile for HASKELL_NIXOS_FULL_CAPABILITY_PRD.md. Limits are the PRD section 6.2 defaults; they are finite operational budgets, not delivery estimates.",
  "platforms": {
    "supported": [
      "darwin",
      "linux"
    ],
    "unsupported": [
      "win32"
    ],
    "note": "Windows needs a Job Object/WSL implementation that is not tested; disclosed as unsupported."
  },
  "limits": {
    "heartbeatSeconds": 5,
    "workerIdleSeconds": 180,
    "noProgressSeconds": 600,
    "subprocessWallSeconds": 120,
    "killGraceSeconds": 10,
    "networkRequestSeconds": 15,
    "networkRetries": 2,
    "parserTaskSeconds": 5,
    "analyzerPhaseSeconds": 120,
    "claudeAttemptSeconds": 1200,
    "claudeMaxTurns": 80,
    "compileOperationMaxSeconds": 900,
    "vmOperationMaxSeconds": 1800,
    "attemptsPerRequirement": 3,
    "sameFailureRepeats": 2,
    "runWallSeconds": 43200,
    "runMaxAttempts": 150,
    "claudeBudgetUsd": 50,
    "perAttemptBudgetUsd": 6,
    "retryBackoffMaxSeconds": 60,
    "resource": {
      "maxRssMiB": 6144,
      "maxOutputMiB": 256,
      "maxLogMiB": 5,
      "minFreeDiskGiB": 5,
      "cpu": "No separate CPU cap: wall-clock deadlines bound CPU time. Disclosed, not silently omitted."
    }
  },
  "worker": {
    "concurrency": 1,
    "command": "claude",
    "bare": false,
    "permissionMode": "dontAsk",
    "permissionPrompts": "none",
    "model": null,
    "mcp": "disabled",
    "allowedTools": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(node:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(python3:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(diff:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(touch:*)",
      "Bash(cd:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(pwd:*)",
      "Bash(cut:*)",
      "Bash(uniq:*)",
      "Bash(tr:*)",
      "Bash(awk:*)",
      "Bash(which:*)"
    ],
    "disallowedTools": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git stash:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git branch:*)",
      "Bash(git tag:*)",
      "Bash(git remote:*)",
      "Bash(git config:*)",
      "Bash(npm publish:*)",
      "Bash(npm login:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm ci:*)",
      "Bash(npx:*)",
      "Bash(gh:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(doas:*)",
      "Bash(nixos-rebuild:*)",
      "Bash(nix-env:*)",
      "Bash(systemctl:*)",
      "Bash(launchctl:*)",
      "Bash(kill:*)",
      "Bash(pkill:*)",
      "Bash(killall:*)",
      "Bash(rm:*)",
      "Edit(.loop-engineering/**)",
      "Write(.loop-engineering/**)",
      "Read(.loop-engineering/**)",
      "Edit(scripts/loop-engineering/lib/**)",
      "Write(scripts/loop-engineering/lib/**)",
      "Edit(scripts/loop-engineering/run.mjs)",
      "Write(scripts/loop-engineering/run.mjs)",
      "Edit(HASKELL_NIXOS_FULL_CAPABILITY_PRD.md)",
      "Write(HASKELL_NIXOS_FULL_CAPABILITY_PRD.md)"
    ],
    "honestLimits": [
      "Bash(node:*) can run arbitrary JavaScript, so the allow list scopes tool use but is not a filesystem sandbox. The controller therefore re-verifies every attempt itself and the final phase re-runs all suites from scratch; worker claims and worker-written evidence are never trusted.",
      "The installed Claude CLI has no --max-turns flag; the 80-turn cap is enforced externally by counting assistant turns in the stream and terminating the attempt.",
      "Bash(rm:*) is denied outright: workers delete files with node or by overwriting, which keeps destructive shell commands out of the unattended profile."
    ],
    "protectedPaths": [
      ".loop-engineering/",
      "scripts/loop-engineering/lib/",
      "scripts/loop-engineering/run.mjs",
      "HASKELL_NIXOS_FULL_CAPABILITY_PRD.md"
    ]
  },
  "serve": {
    "host": "127.0.0.1",
    "port": 4317,
    "lingerSeconds": 3600
  },
  "approvedExecutables": [
    "node",
    "npm",
    "python3",
    "git",
    "nix",
    "ghc",
    "cabal",
    "stack"
  ],
