{
  "profileVersion": 1,
  "name": "assurance-differentiation",
  "description": "Execution profile for AGENTIC_SECURITY_DIFFERENTIATION_PRD.md. Limits are the PRD section 7 defaults: finite operating caps, not delivery estimates and not spending authorization. Every suite has a protected wrapper (scripts/assurance-differentiation/test/ or the loop suite's own files); a wrapper runs the real scoped test files and re-emits each result under its own name.",
  "platforms": {
    "supported": [
      "darwin",
      "linux"
    ],
    "unsupported": [
      "win32"
    ],
    "note": "Windows needs a Job Object/WSL implementation that is not tested; disclosed as unsupported."
  },
  "limits": {
    "heartbeatSeconds": 5,
    "workerIdleSeconds": 180,
    "noProgressSeconds": 600,
    "subprocessWallSeconds": 120,
    "killGraceSeconds": 10,
    "claudeAttemptSeconds": 1200,
    "claudeMaxTurns": 80,
    "attemptsPerRequirement": 3,
    "sameFailureRepeats": 2,
    "runWallSeconds": 43200,
    "runMaxAttempts": 150,
    "claudeBudgetUsd": 50,
    "perAttemptBudgetUsd": 6,
    "retryBackoffMaxSeconds": 60,
    "networkRequestSeconds": 15,
    "networkRetries": 2,
    "unknownBillingReserveUsd": 6,
    "suiteCeilings": {
      "standard": {
        "ceilingSeconds": 120,
        "childLeaseSeconds": 90
      },
      "runtime-integration": {
        "ceilingSeconds": 900,
        "childLeaseSeconds": 600
      },
      "full-evaluation": {
        "ceilingSeconds": 7200,
        "childLeaseSeconds": 3600
      }
    },
    "resource": {
      "maxRssMiB": 6144,
      "maxOutputMiB": 256,
      "maxLogMiB": 5,
      "minFreeDiskGiB": 5,
      "cpu": "No separate CPU cap: wall-clock deadlines bound CPU time. Disclosed, not silently omitted."
    }
  },
  "providerEnvelope": {
    "enabled": false,
    "capUsd": 25,
    "unknownBillingReserveUsd": 25,
    "preauthorization": null,
    "note": "A separate, separately metered budget for controller-run steps that declare a cost (costUsd, or costUnknown for the reserve). Off by default: enabling it needs a preauthorization { by, at, capUsd } recorded here by a person. It is never paid from claudeBudgetUsd."
  },
  "worker": {
    "concurrency": 1,
    "command": "claude",
    "bare": false,
    "permissionMode": "dontAsk",
    "permissionPrompts": "none",
    "model": null,
    "mcp": "disabled",
