      "Write(scripts/loop-engineering/test/**)",
      "Edit(scripts/assurance-differentiation/test/**)",
      "Write(scripts/assurance-differentiation/test/**)"
    ],
    "honestLimits": [
      "Bash(node:*) can run arbitrary JavaScript, so the allow list scopes tool use but is not a filesystem sandbox. The controller re-verifies every attempt itself and the final phase re-runs all suites from scratch; worker claims and worker-written evidence are never trusted. Read confinement of verifier keys and sealed labels is the job of CORE-003, not of this profile.",
      "The installed Claude CLI has no --max-turns flag; the 80-turn cap is enforced externally by counting assistant turns in the stream and terminating the attempt.",
      "Edit/Write deny rules protect the controller, profile and protected suite wrappers from the worker tool surface only; a worker running node can still write any path the OS user can. Evidence signing and tree-digest staleness, not these rules, are what make tampering visible.",
      "Bash(rm:*) is denied outright: workers delete files with node or by overwriting."
    ],
    "protectedPaths": [
      ".loop-engineering/",
      "scripts/loop-engineering/",
      "scripts/assurance-differentiation/test/",
      "AGENTIC_SECURITY_DIFFERENTIATION_PRD.md"
    ]
  },
  "serve": {
    "host": "127.0.0.1",
    "port": 4317,
    "lingerSeconds": 3600
  },
  "approvedExecutables": [
    "node",
    "npm",
    "python3",
    "git"
  ],
  "unenforced": [
    {
      "field": "heartbeatSeconds",
      "requested": 5,
      "status": "partial",
      "note": "The controller heartbeats on a fixed internal interval and judges stale at a fixed 15 s (STALE_AFTER_MS); the profile value is validated as finite but not read by the controller. The PRD figures match the constants today; they are not profile-configurable."
    },
    {
      "field": "subprocessWallSeconds",
      "requested": 120,
      "status": "unenforced",
      "note": "Validated as finite only. Each suite and gate is bounded by its own timeoutSeconds, which is what is enforced."
    },
    {
      "field": "networkRequestSeconds",
      "requested": 15,
      "status": "unsupported",
      "note": "The controller has no network client or accounting; PRD CORE-004 owns bounded I/O for product code."
    },
    {
      "field": "networkRetries",
      "requested": 2,
      "status": "unsupported",
      "note": "As networkRequestSeconds."
    },
    {
      "field": "suiteCeilings",
      "requested": "120 / 900 / 7200 seconds with finite per-child leases",
      "status": "partial",
      "note": "Per-suite timeoutSeconds is enforced and ceilings are set per suite key; there is no separate per-child lease inside a suite wrapper."
    },
    {
      "field": "providerEnvelopeUsd",
      "requested": 25,
      "status": "unsupported",
      "note": "The controller meters only the model worker (claudeBudgetUsd). A separate provider or infrastructure envelope has no accounting; enabling one needs new resource accounting before it can be claimed."
    },
    {
      "field": "unknownBillingReserve",
      "requested": "stop paid tasks or use an upper-bound reserve",
      "status": "partial",
      "note": "perAttemptBudgetUsd is passed to the CLI as a ceiling and run spend is tracked from reported cost; a CLI that reports no cost is not given a defined upper-bound reserve."
    },
    {
      "field": "budgetsAreCapsNotAuthorization",
      "requested": "claudeBudgetUsd 50 and perAttemptBudgetUsd 6",
      "status": "documentation-only",
      "note": "These are explicit ceilings. Nothing in the profile authorizes spend; a real run needs a logged-in CLI and a supervising decision."
    },
    {
      "field": "linuxEnforcementBackend",
      "requested": "proven read/network/process confinement",
      "status": "unsupported",
      "note": "Not part of the controller. CORE-003 and X-502 own it; requiresTools is not set on any suite yet because the backend is not chosen."
    }
  ],
