{
  "profileVersion": 1,
  "name": "assurance-differentiation",
  "description": "Execution profile for AGENTIC_SECURITY_DIFFERENTIATION_PRD.md. Limits are the PRD section 7 defaults: finite operating caps, not delivery estimates and not spending authorization. Suites other than loop are declared not-yet-runnable until their protected wrappers exist.",
  "platforms": {
    "supported": [
      "darwin",
      "linux"
    ],
    "unsupported": [
      "win32"
    ],
    "note": "Windows needs a Job Object/WSL implementation that is not tested; disclosed as unsupported."
  },
  "limits": {
    "heartbeatSeconds": 5,
    "workerIdleSeconds": 180,
    "noProgressSeconds": 600,
    "subprocessWallSeconds": 120,
    "killGraceSeconds": 10,
    "claudeAttemptSeconds": 1200,
    "claudeMaxTurns": 80,
    "attemptsPerRequirement": 3,
    "sameFailureRepeats": 2,
    "runWallSeconds": 43200,
    "runMaxAttempts": 150,
    "claudeBudgetUsd": 50,
    "perAttemptBudgetUsd": 6,
    "retryBackoffMaxSeconds": 60,
    "resource": {
      "maxRssMiB": 6144,
      "maxOutputMiB": 256,
      "maxLogMiB": 5,
      "minFreeDiskGiB": 5,
      "cpu": "No separate CPU cap: wall-clock deadlines bound CPU time. Disclosed, not silently omitted."
    }
  },
  "worker": {
    "concurrency": 1,
    "command": "claude",
    "bare": false,
    "permissionMode": "dontAsk",
    "permissionPrompts": "none",
    "model": null,
    "mcp": "disabled",
    "allowedTools": [
      "Read",
