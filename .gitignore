scanner/node_modules/
ide/vscode/node_modules/
ide/vscode/dist/

# superpowers:subagent-driven-development scratch workspace (ledgers, task
# briefs, review packages) — per-plan working state, never meant to enter
# history. Delete when a plan finishes; this entry just stops an accidental
# `git add`/`git commit` from tracking it in the meantime.
.superpowers/

# scanner/dist/agentic-security.mjs IS tracked in git on purpose: the
# reusable .github/workflows/scan.yml fetches it from raw.githubusercontent.com
# at HEAD-of-main so downstream CI users don't need to install anything to use
# the action. Tests run against scanner/src/ directly via the Node test runner.
# (Premortem 4R-2: the previous gitignore comment claimed dist was "Not
# committed" — incorrect. The file IS committed; only the rest of dist/ is
# transient build output we don't care to track.)
scanner/dist/*
!scanner/dist/agentic-security.mjs
!scanner/dist/agentic-security.mjs.sha256
!scanner/dist/calibration-seed.json
# The bundle is committed so it can be run from a fresh clone without a build.
# Its DATA has to be committed for the same reason: auditor-walkthrough resolves
# compliance-frameworks/ relative to the bundle, and when only the .mjs was
# tracked the shipped CLI silently listed ZERO frameworks and exited 0.
!scanner/dist/compliance-frameworks/
!scanner/dist/compliance-frameworks/*.json
# Third instance of the same bug class. ncc code-splits every dynamically-
# imported internal module (bin/agentic-security.js has ~58 `await
# import('../src/...')` call sites, one per lazily-loaded subcommand) into
# its own numbered dist/NNN.index.js chunk, loaded by the main bundle via a
# runtime import() relative to its own location on disk. Those chunks were
# never allowlisted here, so a checkout with ONLY the committed
# agentic-security.mjs (exactly the shape of a fresh CI clone, or the
# reusable workflow's raw.githubusercontent.com single-file fetch above)
# throws ERR_MODULE_NOT_FOUND the moment a lazy subcommand path — e.g. the
# MTTR wiring behind an ordinary `scan` — actually runs. Invisible on any
# machine that has ever run `npm run build` locally, since the chunks exist
# on disk there regardless of git tracking.
!scanner/dist/*.index.js
# Fourth instance of the same bug class: `explore` and `dataflow export
# --format html` both locate the Data Flow Explorer frontend at runtime via
# scanner/dist/frontend/ (copied there at build time by
# scanner/scripts/copy-frontend.mjs — see src/shared/frontend-root.js for
# why). Without this negation the copy exists on disk after `npm run build`
# but is invisible to a fresh clone/npm-published-package, reproducing the
# exact "works locally, 404s for every real user" bug this file's own two
# comments above already describe for other dist/ subtrees.
!scanner/dist/frontend/
!scanner/dist/frontend/**
# Ignore all .agentic-security/ dirs at any depth. For the root one,
# ignore all contents but un-ignore the config files that belong in VCS.
**/.agentic-security/
!/.agentic-security/
/.agentic-security/*
!/.agentic-security/rules.yml
!/.agentic-security/license-policy.yml
*.log
.DS_Store

# Real-world benchmark cache — external repos cloned on demand, never committed.
# Keyed by {app}-{sha} so updating the manifest invalidates only that entry.
scanner/test/benchmark/realworld/.bench-cache/

# BigQuery GitHub coverage bench — per-cycle output contains third-party source
# code (under permissive licenses) and raw scanner findings keyed by repo+file.
# By policy (bench/bigquery-github/README.md) these stay local and are not
# republished. Only summary.md aggregate tables are reviewable, and even those
# do not get committed.
bench/bigquery-github/cycle-*/

# CHANGELOG.md is copied into scanner/ at npm publish (prepublishOnly) so it
# ships in the package; the canonical copy lives at the repo root.
scanner/CHANGELOG.md

# OWASP LLM Top 10 goat benchmark — external repos cloned on demand.
scanner/test/benchmark/llm-goats/.cache/

# Python caches from compliance helper scripts (scripts/{nist,owasp-asvs,pci,soc2}/).
__pycache__/

# Compliance attestation outputs are generated per-project, not committed.
nist-ai-600-1-attestation.*
owasp-asvs-attestation.*
owasp-llm-top10-attestation.*
pci-dss-attestation.*
eu-ai-act-attestation.*
HARNESS_SCORE.*

# Per-scan output files written into project's .agentic-security/ dir.
findings.json
findings.sarif
findings.csv
last-scan.json

# HTML reports generated by /show-findings
reports/findings-*.html

# CVE-replay runner outputs — timestamped JSON snapshots, regenerated each run.
bench/cve-replay/results/*.json

# AI-BOM artefact emitted by the scanner during dev runs.
scanner/aibom.md

# Local report dumps from interactive runs of the scanner.
scanner/reports/

# Agent worktrees. Created inside the repo by the harness's worktree tooling,
# which does not add its own ignore rule. Left untracked they are indistinguish-
# able from real work: `release-check`'s working-tree-clean gate fails and
# `npm publish` aborts with nothing obviously wrong. Note this ignores ONLY the
# worktrees directory — `.claude/settings.json` is the team's committed
# read-deny list and must stay tracked.
.claude/worktrees/

# Gate verdict cache (PRD R1) — per-machine, never shared, never committed.
.agentic-security/gate-verdicts.json

# Independent evaluation population: upstream source is FETCHED, never vendored.
bench/independent/cache/
bench/sca-replay/cache/
bench/prompt-injection/cache/

# why-missed.mjs's per-entry diagnostic output — regenerated working data.
# Chunked-run intermediates. A whole-population pass wedged once and took every
# already-scored entry with it, so runner.mjs now runs in slices; these are the
# per-slice outputs. The MERGED artifacts (RESULT.json, RESULT-deep.json) are
# committed and are what anything downstream reads — the chunks are
# reproducible from a re-run and would add ~40 files per configuration.
bench/independent/RESULT-chunk-*.json

bench/independent/why-missed-output/

# Cross-run discovery memory (PRD C4) — per-project state, never committed.
.agentic-security/discovery-memory.json

# JetBrains plugin build output. `gradle/wrapper/` and `gradlew*` are NOT here —
# the wrapper is committed on purpose (the README tells contributors to run
# ./gradlew, and it pins the Gradle distribution by checksum).
ide/jetbrains/.gradle/
ide/jetbrains/.intellijPlatform/
ide/jetbrains/build/

# Source PRD working documents kept in the repo root. Untracked deliberately:
# this is a PUBLIC repository, and these are internal requirement documents
# nobody has asked to publish. Track one explicitly if that ever changes.
/*-PRD.docx
/*_PRD.docx
