  "divergences": [
    {
      "id": "D1",
      "status": "closed",
      "closedBy": "E3-03",
      "summary": "Seven different result shapes for 'verified' (verifiedFull+degradedLegs, verified only, completeness, tier+gates, outcome, applied+restored). apply_fix with a caller patch returns no verifiedFull although the tool text promises it; verify_fix computes verifiedFull but does not return it.",
      "closedIn": "E3-03"
    },
    {
      "id": "D2",
      "status": "open",
      "closedBy": "E3-04",
      "summary": "The PoC leg is requested only by verify_fix; applyVerifiedFix and the caller-patch branch report it not-requested, while autopilot and --require-proof use exploit replay as a hard gate. E3-03 made the stored-PoC rule one rule (signed scans only); a finding with no stored PoC still has no replay leg on any route (E3-04)."
    },
    {
      "id": "D3",
      "status": "closed",
      "closedBy": "E3-05",
      "summary": "verifyFix runs the project tests on the current tree, before the patch is written. It sets testedPrePatch and says so in its summary, yet reports verifiedFull true with no degraded leg, so a passing test leg says nothing about the patch (autopilot writes first, so its test leg does test the patch). E3-03 surfaces this: the record marks behaviorTests not_run on every route, so verifiedFull is false; running the tests on the patched tree is E3-05.",
      "closedIn": "E3-05"
    },
    {
      "id": "D4",
      "status": "closed",
      "closedBy": "E3-03",
      "summary": "AGENTIC_SECURITY_FIX_RUN_TESTS=1 swaps the verifier in the caller-patch branch for verifyFixWithTests and drops fixMeta, the honesty gate and the PoC leg; there are two test-runner implementations.",
      "closedIn": "E3-03"
    },
    {
      "id": "D5",
      "status": "open",
      "closedBy": "E3-06",
      "summary": "Write safeguards differ per route: the baseline-hash race check exists only in applyVerifiedFix; the signed-scan requirement, the high-impact approval gate and the reserved-path list are not applied by the language routes, the SCA route or autopilot."
    },
    {
      "id": "D6",
      "status": "open",
      "closedBy": "E3-07",
      "summary": "autopilot --apply writes with fs.writeFileSync: no fix-history entry, no backup, no undo, no symlink check, no reserved-path check."
    },
    {
      "id": "D7",
      "status": "open",
      "closedBy": "E3-06",
      "summary": "apply_sca_upgrade claims worktree isolation in its header but installs in the real project; restore failures are swallowed; with no test command it returns applied with no test evidence."
    },
    {
      "id": "D8",
      "status": "open",
      "closedBy": "E3-03",
      "summary": "The language routes (R5, R6) do not use the shared service: no approval gate, no reserved-path check, no baseline-hash recheck; R6 hard-codes its rescan and compile gates as not run."
    },
    {
      "id": "D9",
      "status": "open",
      "closedBy": "E3-03",
      "summary": "The honesty gate runs only when fixMeta carries residual, verdict, evidence or signals; the CLI cannot supply them, so the gate never runs from the CLI."
    },
    {
      "id": "D10",
      "status": "closed",
      "closedBy": "E3-05",
      "summary": "A patch that deletes the vulnerable behaviour is accepted as verified: observed on a command-injection route replaced by a handler that always returns 403 (ok and verified true), and on a patch that empties the file.",
      "closedIn": "E3-05"
    }
  ]
