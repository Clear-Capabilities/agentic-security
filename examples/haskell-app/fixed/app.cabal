cabal-version: 3.0
name:          orders-api
version:       0.1.0.0
build-type:    Simple

executable orders-api
  main-is:          Main.hs
  hs-source-dirs:   src
  build-depends:    base >=4.18 && <5
                  , scotty ^>=0.20
                  , sqlite-simple ^>=0.4.18
                  , process
                  , crypton
                  , http-types
                  , aeson >=2.1
  default-language: Haskell2010
