  "decisionRule": {
    "id": "graph-arm-decision-rule",
    "version": 1,
    "demoteSourceFindingWhen": [
      "exposure:blocked",
      "exposure:none-found and graph-gap-count:0"
    ],
    "keepSourceFindingWhen": [
      "exposure:possible",
      "exposure:runtime-supported",
      "exposure:unresolved",
      "exposure:not-assessed"
    ],
    "addDeploymentFindingWhen": [
      "path-state:possible or runtime-supported from an exposed entry to a privileged resource"
    ]
  },
  "labelsHash": "sha256:bc990564971b14e960a9229cb12ac5d903531fca53cfaaea52ba5c96c1686acf",
  "cases": [
    {
      "id": "compose-published-vs-internal",
      "title": "The same handler with a published port and on an internal-only network",
      "kind": "source-finding",
      "defect": {
        "family": "command-injection",
        "file": "services/api/handler.js"
      },
      "sourceDigest": "sha256:8e2855406a38d490b295f528c7fe3f0617c817cfc9d86b196a6c28a083f763fd",
      "deployments": {
        "exploitable": {
          "digest": "sha256:8b88d4b9e3f3728aa37427f217495a9d514001341242cdfac741f5c206f3f626",
          "exploitable": true,
          "rationale": "The compose file publishes port 8080 on all interfaces for the service."
        },
        "non-exploitable": {
          "digest": "sha256:888c8927df8cf9ed54a2df375951b43a96b0255ef966a60a32f1a90a336548ec",
          "exploitable": false,
          "rationale": "The service publishes no port and sits on an internal-only network."
        }
      }
    },
    {
      "id": "k8s-admin-grant-vs-no-grant",
      "title": "A public admin service with and without a privilege grant",
      "kind": "deployment-only",
      "defect": {
        "family": "deployment-exposure",
        "file": null
      },
      "sourceDigest": "sha256:c9f0a75cfefb2d0a6a6d8a7786de0e49a998cc97e8c44c3cdf9d1485b2577a00",
      "deployments": {
        "exploitable": {
          "digest": "sha256:54ff5f59fce63240554d60c4337f974a7fcbc9fc7f24503879c57e19253f70ef",
          "exploitable": true,
          "rationale": "A public ingress reaches an admin workload whose service account is bound to a secret-reading role."
        },
        "non-exploitable": {
          "digest": "sha256:e8eba8b99c69e8dd573eb0d26de9ceea75de9bf2318d67d2db98177dd071c528",
          "exploitable": false,
          "rationale": "The same public ingress reaches the workload, but its service account has no role binding."
        }
      }
    },
    {
      "id": "k8s-admin-ingress-vs-internal",
      "title": "An unauthenticated admin service with secret access, public versus internal",
      "kind": "deployment-only",
      "defect": {
        "family": "deployment-exposure",
        "file": null
      },
      "sourceDigest": "sha256:c9f0a75cfefb2d0a6a6d8a7786de0e49a998cc97e8c44c3cdf9d1485b2577a00",
      "deployments": {
        "exploitable": {
          "digest": "sha256:54ff5f59fce63240554d60c4337f974a7fcbc9fc7f24503879c57e19253f70ef",
          "exploitable": true,
          "rationale": "A public ingress reaches an admin workload whose service account can read secrets."
        },
        "non-exploitable": {
          "digest": "sha256:403b23adc090bad394eeff11a24d56d6295adbd8fd28fe90cd3825948b9aac08",
          "exploitable": false,
          "rationale": "The admin workload has the same secret access but no ingress reaches it."
        }
      }
    },
    {
      "id": "k8s-finding-unbound",
      "title": "The same handler where no service binding is supplied",
      "kind": "source-finding",
      "defect": {
        "family": "command-injection",
        "file": "services/api/handler.js"
      },
      "sourceDigest": "sha256:8e2855406a38d490b295f528c7fe3f0617c817cfc9d86b196a6c28a083f763fd",
      "deployments": {
        "exploitable": {
          "digest": "sha256:c3164cb04695537730ca7868476e825b775ea7d67759d218c16323e945cc3ec9",
          "exploitable": true,
          "rationale": "A public ingress routes /api to the service; no binding ties the finding to it."
        },
        "non-exploitable": {
          "digest": "sha256:7d20fc57f8ffb71da91eeb11568a3b13affbc6bff17e94f1225dc353f32cf527",
          "exploitable": false,
          "rationale": "No ingress exists; no binding ties the finding to the service."
        }
      }
    },
    {
      "id": "k8s-gateway-auth",
      "title": "A public admin service with and without gateway authentication the adapters do not read",
      "kind": "deployment-only",
      "defect": {
        "family": "deployment-exposure",
        "file": null
      },
      "sourceDigest": "sha256:c9f0a75cfefb2d0a6a6d8a7786de0e49a998cc97e8c44c3cdf9d1485b2577a00",
      "deployments": {
        "exploitable": {
          "digest": "sha256:54ff5f59fce63240554d60c4337f974a7fcbc9fc7f24503879c57e19253f70ef",
          "exploitable": true,
          "rationale": "A public ingress reaches an admin workload with secret access and no authentication in front of it."
        },
        "non-exploitable": {
          "digest": "sha256:b66bd448d940116331a4b1465bd3151d17a05faf15d3476d651b7d215270fab0",
          "exploitable": false,
          "rationale": "The ingress carries an external authentication annotation, so unauthenticated callers are refused. The adapters do not read ingress annotations, so the boundary graph cannot see this."
        }
      }
    },
    {
      "id": "k8s-ingress-vs-internal",
      "title": "The same handler behind a public ingress and behind an internal-only service",
      "kind": "source-finding",
      "defect": {
        "family": "command-injection",
        "file": "services/api/handler.js"
      },
      "sourceDigest": "sha256:8e2855406a38d490b295f528c7fe3f0617c817cfc9d86b196a6c28a083f763fd",
      "deployments": {
        "exploitable": {
          "digest": "sha256:6fad87d412a5b950a21f5065a8d6fde95b8dc6fdb4f313659ba6978da3ebc33f",
          "exploitable": true,
          "rationale": "A public ingress routes /api to the service running the handler."
        },
        "non-exploitable": {
          "digest": "sha256:a71e4696a1072e93ffe8a0ab21cad1674b047921c3f1ddd5d41cb19653aa1c66",
          "exploitable": false,
          "rationale": "No ingress exists; the only network policy admits a single internal batch workload."
        }
      }
    },
    {
      "id": "k8s-unresolved-ingress",
      "title": "Exposure the supplied configuration cannot fully resolve versus no ingress at all",
      "kind": "source-finding",
      "defect": {
        "family": "command-injection",
        "file": "services/api/handler.js"
      },
      "sourceDigest": "sha256:8e2855406a38d490b295f528c7fe3f0617c817cfc9d86b196a6c28a083f763fd",
      "deployments": {
        "exploitable": {
          "digest": "sha256:ee021557c8e6985f6e97f80d2b24c3b8e0c6fcb265987cc7a2a230de68ad347d",
          "exploitable": true,
          "rationale": "An ingress routes /api to a Service whose manifest was not supplied (a typed gap). Declared by the fixture author: that Service exists and selects the workload, so the handler is exposed."
        },
        "non-exploitable": {
          "digest": "sha256:7bc3beeddb12c5b00953ad8fc3a680cc63e9137644416d94b759fcbcb878d771",
          "exploitable": false,
          "rationale": "No ingress exists; the Service is cluster-internal."
        }
      }
    }
  ],
