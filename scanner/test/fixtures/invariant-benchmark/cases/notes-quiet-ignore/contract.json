  "review": {
    "state": "proposed",
    "origin": "authored"
  },
  "key": "notes-tenant-isolation",
  "revision": 1,
  "name": "An actor never changes another tenant's record through editNote",
  "class": "tenant-isolation",
  "scope": {
    "application": "bench",
    "entry": "app.mjs",
    "factory": "createApp",
    "environment": "disposable-fixture"
  },
  "tenants": [
    {
      "id": "acme"
    },
    {
      "id": "globex"
    }
  ],
  "actors": [
    {
      "id": "ana",
      "tenant": "acme",
      "role": "member"
    },
    {
      "id": "gus",
      "tenant": "globex",
      "role": "member"
    }
  ],
  "resources": [
    {
      "id": "r-acme",
      "kind": "record",
      "tenant": "acme",
      "key": "notes/acme-1",
      "marker": "ACME-PRIVATE-7"
    },
    {
      "id": "r-globex",
      "kind": "record",
      "tenant": "globex",
      "key": "notes/globex-1",
      "marker": "GLOBEX-PRIVATE-7"
    }
  ],
  "transitions": [
    {
      "id": "own-update",
      "action": "editNote",
      "actors": [
        "ana"
      ],
      "resource": "r-acme"
    }
  ],
  "forbidden": [
    {
      "id": "no-cross-tenant-write",
      "op": "cross-tenant-write",
      "prefix": "notes/",
      "bind": "business-state"
    }
  ],
