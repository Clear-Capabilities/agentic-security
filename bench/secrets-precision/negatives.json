      "body": "STRIPE_SECRET_KEY=sk_live_your_key_here_replace_me"
    },
    {
      "id": "go-module-hash",
      "why": "a go.sum hash line",
      "file": "go.sum",
      "body": "github.com/pkg/errors v0.9.1 h1:FEBLx1zS214owpjy7qsBeixbURkuhQAwrK5UwLGTwt4="
    },
    {
      "id": "gemfile-lock-digest",
      "why": "a bundler checksum",
      "file": "Gemfile.lock",
      "body": "   BUNDLED WITH\n   2.3.7\n   CHECKSUMS\n     rails (6.1.0) sha256=8f3e2d1c0b9a8f7e6d5c4b3a29180706f5e4d3c2b1a09f8e7d6c5b4a39281706"
    },
    {
      "id": "minified-bundle-line",
      "why": "a real minified line, dense and high-entropy",
      "file": "dist/vendor.js",
      "body": "!function(e,t){\"object\"==typeof exports?module.exports=t():e.X=t()}(this,function(){var a4f8e9c1b2d3e4f5a6b7c8d9=1;return a4f8e9c1b2d3e4f5a6b7c8d9})"
    },
    {
      "id": "aws-length-base64-blob",
      "why": "a 20-char uppercase blob in a data file, AWS-key length but not AWS-shaped",
      "file": "src/data/regions.js",
      "body": "export const REGION_CODES = ['USEAST1PRIMARY0A2B3', 'EUWEST2SECONDARY9Z8'];"
    },
    {
      "id": "detector-rule-definition",
      "why": "a security rule file that DEFINES key shapes \u2014 the scanner scanning itself",
      "file": "rules/secrets.yml",
      "body": "patterns:\\n  - name: github-pat\\n    regex: 'ghp_[0-9a-zA-Z]{36}'\\n  - name: stripe\\n    regex: 'sk_live_[0-9a-zA-Z]{24}'"
    },
    {
      "id": "npmrc-env-interpolation",
      "why": "a reference to an env var, not a value",
      "file": ".npmrc",
      "body": "//registry.npmjs.org/:_authToken=${NPM_TOKEN}"
    },
    {
      "id": "terraform-state-lineage",
      "why": "a state-file lineage id",
      "file": "terraform.tfstate",
      "body": "{\"version\":4,\"lineage\":\"a1b2c3d4-e5f6-7890-abcd-ef1234567890\",\"serial\":42}"
    },
    {
      "id": "sass-variable-hash",
      "why": "a build hash in a stylesheet variable",
      "file": "src/_vars.scss",
      "body": "$asset-revision: 'sk-9f8e7d6c5b4a39281706f5e4d3c2b1a0f9e8d7c6';"
    },
    {
      "id": "test-snapshot-blob",
      "why": "a jest-style snapshot of random bytes",
      "file": "test/__snapshots__/crypto.test.js.snap",
      "body": "exports[`derives a key 1`] = `\"c5d3e1f9a7b5c3d1e9f7a5b3c1d9e7f5a3b1c9d7e5f3a1b9c7d5e3f1a9b7c5d3\"`;"
    },
    {
      "id": "rotated-key-in-changelog",
      "why": "a changelog noting a rotation, with the key masked",
      "file": "CHANGELOG.md",
      "body": "- Rotated the production Stripe key (was sk_live_****************ab12) after the 2024 audit."
    },
    {
      "id": "openapi-security-scheme",
      "why": "an API spec declaring auth, naming no credential",
      "file": "openapi.yaml",
      "body": "components:\\n  securitySchemes:\\n    bearerAuth:\\n      type: http\\n      scheme: bearer\\n      bearerFormat: JWT"
    }
  ],
  "_headroom": "Negatives are added when the instrument saturates, for the same reason as formats. The eight after minified-bundle-line are the harder tier: strings that are credential-SHAPED and appear in files a scanner will certainly read, including a rule file that defines key formats \u2014 a secrets scanner reporting its own pattern library is a real and embarrassing failure mode."
}
