      "body": ".button_a8f3e9c1b2d4 { color: #1a2b3c; }"
    },
    {
      "id": "docker-image-digest",
      "why": "an image pin",
      "file": "Dockerfile",
      "body": "FROM node@sha256:5e5f6f0a2ea0c9e6e2e6b1e33b8b1e0c8a9d3f2e1b0a9c8d7e6f5a4b3c2d1e0f"
    },
    {
